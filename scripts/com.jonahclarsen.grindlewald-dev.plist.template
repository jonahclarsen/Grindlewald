<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jonahclarsen.grindlewald-dev</string>
  <key>ProgramArguments</key>
  <array>
    <string>__EXECUTABLE__</string>
  </array>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>com.jonahclarsen.grindlewald</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>GRINDLEWALD_DEV_SUPERVISOR</key>
    <string>1</string>
    <key>GRINDLEWALD_REPO</key>
    <string>__REPO__</string>
    <key>GRINDLEWALD_PNPM</key>
    <string>__PNPM__</string>
    <key>GRINDLEWALD_CARGO</key>
    <string>__CARGO__</string>
    <key>GRINDLEWALD_RUSTC</key>
    <string>__RUSTC__</string>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/dev.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/dev.stderr.log</string>
</dict>
</plist>
